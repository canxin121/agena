help-title = Help
help-header = Agena TUI
help-section-sessions = Session switcher
help-sessions-line-1 = /sessions opens the searchable session switcher
help-sessions-line-2 = Up/Down, PageUp/PageDown move selection; Enter opens the selected session
help-sessions-line-3 = /sessions opens the switcher; arguments prefill its filter
help-sessions-line-4 = /rename, /timeline, and /lineage manage the selected session
help-sessions-line-5 = /sessions all, roots, or subtree changes the switcher scope before opening it
help-section-transcript = Transcript pane
help-transcript-line-1 = i enters INSERT mode; j/k or arrows move through complete messages, selected Markdown/activity blocks, and then the lines inside each block; y copies the selected message or block
help-transcript-line-2 = Left/Right and h/l jump only between complete messages; [count]j/k/h/l repeats those motions
help-transcript-line-3 = Select an activity block or collapsed activity group and press Enter to toggle it; Space / Shift+Space / Ctrl+B page
help-transcript-line-4 = PageUp near the top loads older messages
help-transcript-line-5 = g/G jump to top or bottom
help-transcript-line-6 = / searches downward and ? searches upward; n repeats the direction and N reverses it
help-transcript-line-7 = c copies the last assistant message, C copies the loaded transcript, Y copies the visible viewport
help-transcript-line-8 = Use /rename, /timeline, /lineage, /plugins, /export, or /pager for session actions
help-section-composer = Composer
help-composer-line-1 = Esc returns to VIEW mode; Enter sends
help-composer-line-2 = Alt/Shift+Enter or Ctrl+J inserts newline
help-composer-line-3 = Ctrl+A/E/B/F/P/N move, Alt+B/F or Alt/Ctrl+Left/Right jump by word
help-composer-line-4 = Ctrl+H/D/W/U/K/Y edit like a shell or editor
help-composer-line-5 = Ctrl+A/E at a line boundary can continue to the previous/next line
help-composer-line-6 = F3, Ctrl+O, or Alt+O attaches a file (iTerm2 local picker over SSH when available)
help-composer-line-7 = F4 or Alt+E opens $VISUAL/$EDITOR for the composer
help-composer-line-8 = F6 or Alt+I attaches an image (iTerm2 local picker over SSH when available; otherwise clipboard)
help-composer-line-9 = Pasted text is inserted directly; a single file path attaches it, and attachments stay atomic inline elements
help-composer-line-10 = Ctrl+R opens reverse history search; Up/Down at the input edges or Alt+Up/Down switches sent prompts; Ctrl+L clears the composer
help-composer-line-11 = F2 opens inline items when available, and slash commands like /model, /fork, or /rewind run from the composer
help-section-actions = Actions
help-section-user-commands = User commands
help-actions-line-1 = n creates a session; /sessions, /lineage, /parent, /children, and /plugins open session tools
help-actions-line-2 = r continue a blocked or pending session
help-actions-line-3 = p opens the permission prompt, Alt+A opens it from the composer, and a/A/d/D quickly reply to the first pending permission request
help-actions-line-4 = Alt+U opens the first pending user-input request from the composer
help-actions-line-5 = Mouse capture is disabled so terminal selection/copy still works
help-actions-line-6 = Ctrl+C exits on the second press

