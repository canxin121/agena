{
  "tracing": {
    "filter": "info"
  },
  "agents": {
    "default": "plan",
    "plan": {
      "description": "Read-only planning agent",
      "prompt": "You are a planning agent. Break work into concrete steps, surface assumptions and blockers, and keep the output actionable.",
      "permission": {
        "path": {
          "workspace": {
            "read": "allow",
            "write": "deny"
          },
          "external": {
            "read": "ask",
            "write": "ask"
          }
        },
        "tools": {
          "names": {
            "plan": "allow",
            "todo": "allow"
          }
        }
      }
    }
  },
  "providers": {
    "default": "anthropic",
    "anthropic": {
      "defaults": {
        "adapter": "anthropic",
        "model": "claude-sonnet-4-6"
      },
      "auth": {
        "mode": "api",
        "base_url": "https://api.anthropic.com",
        "api_key_env": "ANTHROPIC_API_KEY"
      },
      "adapters": {
        "anthropic": {
          "enabled": true
        }
      }
    }
  },
  "runtime": {},
  "permission": {
    "path": {
      "workspace": {
        "read": "allow",
        "write": "ask"
      },
      "external": {
        "read": "ask",
        "write": "ask"
      }
    },
    "network": {
      "internet": "ask",
      "private": "deny",
      "loopback": "deny",
      "rules": {
        "github.com": "allow"
      }
    },
    "tools": {
      "tags": {
        "filesystem_read": "allow",
        "filesystem_write": "ask",
        "network": "ask",
        "internet": "ask",
        "task": "ask",
        "shell": "ask"
      }
    }
  }
}
