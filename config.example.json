{
  "tracing": {
    "filter": "info"
  },
  "ui": {
    "tui": {
      "graphics": "auto"
    },
    "transcript": {
      "activity": {
        "default_expanded": false,
        "kinds": {
          "reasoning": true
        }
      },
      "tools": {
        "categories": {},
        "overrides": {}
      }
    }
  },
  "runtime": {
    "providers": {
      "client_versions": {
        "codex": "0.144.4",
        "claude": "2.1.209",
        "gemini": "0.50.0",
        "auto_update": true
      }
    },
    "auxiliary_model": null
  },
  "prompts": {
    "mode": "append",
    "order": ["house-style"],
    "disabled": ["legacy-verbose"],
    "inline": [
      {
        "id": "house-style",
        "title": "House style",
        "body": "Prefer direct, concise explanations and show concrete commands."
      }
    ],
    "models": [
      {
        "match": "anthropic/*",
        "mode": "append",
        "order": ["anthropic-notes"],
        "disabled": [],
        "inline": [
          {
            "id": "anthropic-notes",
            "title": "Anthropic model notes",
            "body": "When relevant, call out behavior specific to {{model}}."
          }
        ]
      }
    ]
  },
  "session": {
    "compaction": {
      "auto": true
    },
    "max_turns": 500,
    "auto_title": {
      "enabled": true,
      "message_interval": 5,
      "cooldown_seconds": 300
    }
  },
  "plugins": {},
  "providers": {
    "anthropic": {
      "auth": {
        "mode": "api",
        "subtype": "custom",
        "base_url": "https://api.anthropic.com",
        "api_key": {
          "kind": "env",
          "value": "ANTHROPIC_API_KEY"
        }
      },
      "network": {
        "request_timeout_secs": 120,
        "connect_timeout_secs": 15
      },
      "adapters": {
        "anthropic": {
          "enabled": true
        }
      }
    }
  },
  "permission": {
    "path": {
      "workspace": {
        "read": "allow",
        "write": "auto"
      },
      "external": {
        "read": "auto",
        "write": "auto"
      }
    },
    "network": {
      "internet": "auto",
      "private": "auto",
      "loopback": "auto",
      "rules": {
        "github.com": "allow"
      }
    }
  }
}
