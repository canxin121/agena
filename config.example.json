{
  "tracing": {
    "filter": "info"
  },
  "ui": {
    "tui": {
      "graphics": "auto"
    }
  },
  "runtime": {
    "providers": {
      "client_versions": {
        "codex": "0.144.4",
        "claude": "2.1.209",
        "gemini": "0.50.0"
      }
    }
  },
  "session": {
    "compaction": {
      "auto": true
    },
    "max_turns": 500
  },
  "plugins": {
    "policy": {
      "tool_presentation": {
        "default_mode": "brief"
      },
      "ui_presentation": {
        "default_mode": "summary"
      }
    }
  },
  "providers": {
    "default": "anthropic",
    "anthropic": {
      "defaults": {
        "adapter": "anthropic",
        "model": "claude-sonnet-4-6"
      },
      "auth": {
        "mode": "api",
        "subtype": "custom",
        "base_url": "https://api.anthropic.com",
        "api_key": {
          "kind": "env",
          "value": "ANTHROPIC_API_KEY"
        }
      },
      "network": {
        "request_timeout_secs": 120,
        "connect_timeout_secs": 15
      },
      "adapters": {
        "anthropic": {
          "enabled": true
        }
      }
    }
  },
  "permission": {
    "path": {
      "workspace": {
        "read": "allow",
        "write": "auto"
      },
      "external": {
        "read": "auto",
        "write": "auto"
      }
    },
    "network": {
      "internet": "auto",
      "private": "auto",
      "loopback": "auto",
      "rules": {
        "github.com": "allow"
      }
    }
  }
}
