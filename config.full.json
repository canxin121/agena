{
  "tracing": {
    "filter": "info",
    "database": "error"
  },
  "ui": {
    "locale": null,
    "tui": {
      "color_scheme": "auto",
      "graphics": "auto",
      "theme": null
    }
  },
  "runtime": {
    "providers": {
      "client_versions": {
        "codex": "0.144.4",
        "claude": "2.1.209",
        "gemini": "0.50.0"
      }
    }
  },
  "session": {
    "compaction": {
      "auto": true,
      "reserved_tokens": 12000
    }
  },
  "agents": {
    "default": "plan",
    "plan": {
      "description": "Read-only planning agent",
      "prompt": "You are a planning agent. Break work into concrete steps, surface assumptions and blockers, and keep the output actionable.",
      "permission": {
        "path": {
          "workspace": {
            "read": "allow",
            "write": "deny"
          },
          "external": {
            "read": "ask",
            "write": "ask"
          }
        },
        "tools": {
          "names": {
            "plan": "allow",
            "tools": "allow",
            "user": "allow",
            "agent": "allow",
            "session": "allow"
          }
        }
      }
    }
  },
  "permission": {
    "path": {
      "workspace": {
        "read": "allow",
        "write": "ask"
      },
      "external": {
        "read": "ask",
        "write": "ask"
      },
      "rules": {
        "<cwd>/.env*": {
          "read": "ask",
          "write": "deny"
        },
        "<cwd>/secrets/**": {
          "read": "deny",
          "write": "deny"
        }
      }
    },
    "network": {
      "internet": "ask",
      "private": "deny",
      "loopback": "deny",
      "rules": {
        "github.com:443": "allow",
        "api.github.com": "allow",
        "*.corp.local": "ask",
        "*.corp.local:8443": "allow",
        "10.0.0.0/8": "deny",
        "172.16.0.0/12:*": "ask",
        "fd00::/8": "deny",
        "[::1]:3000": "ask"
      }
    },
    "tools": {
      "tags": {
        "filesystem_read": "allow",
        "filesystem_write": "ask",
        "settings_read": "allow",
        "settings_write": "ask",
        "network": "ask",
        "internet": "ask",
        "task": "ask",
        "shell": "ask"
      },
      "names": {
        "agena.process.run": "ask",
        "agena.fs.apply_patch": "ask"
      }
    }
  },
  "plugins": {
    "policy": {
      "tool_presentation": {
        "default_mode": "detailed"
      },
      "ui_presentation": {
        "default_mode": "detailed"
      }
    },
    "list": {
      "agena.skills": {
        "package": {
          "kind": "static"
        }
      },
      "agena.lsp": {
        "package": {
          "kind": "static"
        },
        "config": {
          "servers": {}
        }
      },
      "agena.cron": {
        "package": {
          "kind": "static"
        }
      },
      "agena.code": {
        "package": {
          "kind": "static"
        }
      },
      "agena.fs": {
        "package": {
          "kind": "static"
        }
      },
      "agena.settings": {
        "package": {
          "kind": "static"
        }
      },
      "agena.process": {
        "package": {
          "kind": "static"
        }
      },
      "agena.plan": {
        "package": {
          "kind": "static"
        },
        "config": {
          "default_autorun": true,
          "allow_direct_approval": true
        }
      },
      "agena.memory": {
        "package": {
          "kind": "static"
        },
        "config": {
          "project_instructions": {
            "enabled": true,
            "include_global": true
          },
          "retrieval": {
            "enabled": true,
            "limit": 3,
            "min_query_chars": 8
          }
        }
      },
      "agena.web": {
        "package": {
          "kind": "static"
        },
        "config": {
          "fetch": {
            "enabled": true,
            "request": {
              "delay_ms": 400,
              "timeout_secs": 30,
              "max_body_bytes": 5242880,
              "respect_robots_txt": true
            },
            "cache": {
              "ttl_secs": 900,
              "capacity": 128
            }
          },
          "crawl": {
            "defaults": {
              "max_pages": 10,
              "max_depth": 1,
              "same_host_only": true
            },
            "limits": {
              "max_pages": 100,
              "max_depth": 4
            },
            "indexing": {
              "document_cache_ttl_secs": 86400,
              "chunk_chars": 1800,
              "near_duplicate_hamming_distance": 3
            }
          },
          "search": {
            "default_limit": 5,
            "max_limit": 20
          },
          "store": {
            "retention": {
              "max_documents": 200,
              "max_bytes": 104857600
            }
          },
          "browser": {
            "enabled": false,
            "executable_path": null,
            "wait": {
              "for_network_idle": true,
              "timeout_secs": 10,
              "for_selector": null,
              "delay_ms": 0
            }
          }
        }
      },
      "agena.mcp": {
        "package": {
          "kind": "static"
        },
        "config": {
          "servers": {
            "docs": {
              "transport": "http",
              "endpoint": {
                "url": "https://developers.openai.com/mcp",
                "headers": {}
              },
              "auth": {
                "kind": "bearer_from_env",
                "env": "DOCS_MCP_TOKEN"
              }
            }
          }
        }
      }
    }
  },
  "harnesses": {
    "browser": {
      "default": {
        "driver": "playwright",
        "headless": true,
        "viewport": {
          "width": 1280,
          "height": 800
        },
        "allowed_domains": [
          "example.com",
          "github.com"
        ]
      }
    },
    "shell": {
      "default": {
        "workspace_only": true,
        "deny_commands": [
          "sudo",
          "rm -rf /"
        ]
      }
    },
    "editor": {
      "default": {
        "workspace_only": true,
        "max_file_bytes": 262144
      }
    }
  },
  "providers": {
    "default": "openai",
    "openai": {
      "defaults": {
        "adapter": "openai_responses",
        "model": "gpt-5.5"
      },
      "auth": {
        "mode": "api",
        "subtype": "custom",
        "base_url": "https://api.openai.com",
        "api_key": {
          "kind": "env",
          "value": "OPENAI_API_KEY"
        }
      },
      "network": {
        "request_timeout_secs": 120,
        "connect_timeout_secs": 15
      },
      "adapters": {
        "openai_responses": {
          "enabled": true,
          "models": {
            "gpt-5.5": {
              "provider_tools": {
                "enabled": true,
                "routes": {
                  "web_search": "provider_hosted",
                  "file_search": "provider_hosted",
                  "code_execution": "provider_hosted"
                },
                "hosted": {
                  "web_search": {
                    "allowed_domains": [
                      "platform.openai.com",
                      "developers.openai.com"
                    ],
                    "freshness": "cached"
                  },
                  "file_search": {
                    "vector_store_ids": [
                      "vs_docs_main"
                    ],
                    "max_results": 8,
                    "include_results": true
                  },
                  "code_execution": {
                    "container": {
                      "type": "auto",
                      "memory_limit": "4g",
                      "file_ids": [
                        "file_seed_csv"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "openai_chat_completions": {
          "enabled": false,
          "models": {
            "gpt-4.1-mini": {}
          }
        },
        "openai_realtime": {
          "enabled": false,
          "realtime_ws_url": "wss://api.openai.com/v1/realtime",
          "models": {
            "gpt-realtime": {}
          }
        }
      }
    },
    "anthropic": {
      "defaults": {
        "adapter": "anthropic",
        "model": "claude-sonnet-4-6"
      },
      "auth": {
        "mode": "api",
        "subtype": "custom",
        "base_url": "https://api.anthropic.com",
        "api_key": {
          "kind": "env",
          "value": "ANTHROPIC_API_KEY"
        }
      },
      "adapters": {
        "anthropic": {
          "enabled": true,
          "models": {
            "claude-sonnet-4-6": {
              "provider_tools": {
                "enabled": true,
                "routes": {
                  "web_search": "provider_hosted",
                  "bash": "provider_harness",
                  "text_editor": "provider_harness",
                  "computer": "provider_harness"
                },
                "harness": {
                  "bash": {
                    "kind": "shell",
                    "name": "default"
                  },
                  "text_editor": {
                    "kind": "editor",
                    "name": "default"
                  },
                  "computer": {
                    "kind": "browser",
                    "name": "default"
                  }
                },
                "hosted": {
                  "web_search": {
                    "allowed_domains": [
                      "docs.anthropic.com"
                    ],
                    "freshness": "live"
                  }
                }
              }
            }
          }
        }
      }
    },
    "openai_chatgpt": {
      "defaults": {
        "adapter": "openai_responses",
        "model": "gpt-5.3-codex"
      },
      "auth": {
        "mode": "credential",
        "issuer": "openai_chatgpt",
        "credential": {
          "type": "oauth",
          "issuer": "openai_chatgpt",
          "refresh": "openai-refresh-token",
          "access": "openai-access-token",
          "expires_at_ms": 4102444800000,
          "account_id": "acct-example"
        }
      },
      "adapters": {
        "openai_responses": {
          "enabled": true,
          "backend": "chatgpt_codex"
        }
      }
    },
    "github-copilot": {
      "defaults": {
        "adapter": "openai_chat_completions",
        "model": "gpt-4o-mini"
      },
      "auth": {
        "mode": "credential",
        "issuer": "github_copilot",
        "credential": {
          "type": "oauth",
          "issuer": "github_copilot",
          "refresh": "copilot-refresh-token",
          "access": "copilot-access-token",
          "expires_at_ms": 4102444800000
        }
      },
      "adapters": {
        "openai_chat_completions": {
          "enabled": true,
          "models": {
            "gpt-4o-mini": {}
          }
        },
        "anthropic": {
          "enabled": true,
          "models": {
            "claude-sonnet-4": {}
          }
        }
      }
    },
    "ollama": {
      "defaults": {
        "adapter": "ollama",
        "model": "qwen3:14b"
      },
      "adapters": {
        "ollama": {
          "enabled": true,
          "base_url": "http://localhost:11434"
        }
      }
    },
    "gitlab": {
      "defaults": {
        "adapter": "gitlab",
        "model": "claude-sonnet-4-5"
      },
      "auth": {
        "mode": "credential",
        "issuer": "gitlab",
        "credential": {
          "type": "oauth",
          "issuer": "gitlab",
          "refresh": "gitlab-refresh-token",
          "access": "gitlab-access-token",
          "expires_at_ms": 4102444800000
        }
      },
      "adapters": {
        "gitlab": {
          "enabled": true,
          "instance_url": "https://gitlab.com",
          "ai_gateway_url": "https://cloud.gitlab.com"
        }
      }
    },
    "shared-gateway": {
      "defaults": {
        "adapter": "openai_chat_completions",
        "model": "gpt-4.1-mini"
      },
      "auth": {
        "mode": "api",
        "subtype": "custom",
        "base_url": "https://api.cxits.cn/",
        "api_key": {
          "kind": "env",
          "value": "CX_API_KEY"
        },
        "protocol_paths": {
          "openai": "/v1",
          "anthropic": "/v1",
          "gemini": "/v1beta"
        }
      },
      "adapters": {
        "openai_chat_completions": {
          "enabled": true,
          "models": {
            "gpt-4.1-mini": {}
          }
        },
        "anthropic": {
          "enabled": true,
          "models": {
            "claude-sonnet-4": {}
          }
        },
        "gemini": {
          "enabled": true,
          "models": {
            "gemini-2.5-pro": {}
          }
        }
      }
    },
    "cline_api": {
      "defaults": {
        "adapter": "openai_chat_completions",
        "model": "cline-pass/qwen3.7-max"
      },
      "auth": {
        "mode": "api",
        "subtype": "cline_api",
        "api_key": {
          "kind": "env",
          "value": "CLINE_API_KEY"
        }
      },
      "adapters": {
        "openai_chat_completions": {
          "enabled": true,
          "models_url": "https://api.cline.bot/api/v1/ai/cline/recommended-models",
          "models": {
            "cline-pass/qwen3.7-max": {}
          }
        }
      }
    },
    "google-vertex": {
      "defaults": {
        "adapter": "openai_chat_completions",
        "model": "google/gemini-2.5-flash"
      },
      "auth": {
        "mode": "api",
        "subtype": "custom",
        "base_url": "https://us-central1-aiplatform.googleapis.com",
        "api_key": {
          "kind": "env",
          "value": "GOOGLE_VERTEX_ACCESS_TOKEN"
        },
        "protocol_paths": {
          "openai": "/v1/projects/PROJECT/locations/us-central1/endpoints/openapi"
        }
      },
      "adapters": {
        "openai_chat_completions": {
          "enabled": true,
          "capability_family": "gemini"
        }
      }
    },
    "google-ai": {
      "defaults": {
        "adapter": "gemini",
        "model": "gemini-2.5-pro"
      },
      "auth": {
        "mode": "api",
        "subtype": "custom",
        "base_url": "https://generativelanguage.googleapis.com",
        "api_key": {
          "kind": "env",
          "value": "GOOGLE_API_KEY"
        }
      },
      "adapters": {
        "gemini": {
          "enabled": true,
          "models": {
            "gemini-2.5-pro": {
              "provider_tools": {
                "enabled": true,
                "routes": {
                  "web_search": "provider_hosted",
                  "url_context": "provider_hosted",
                  "code_execution": "provider_hosted"
                },
                "hosted": {
                  "web_search": {
                    "freshness": "live",
                    "max_results": 6
                  },
                  "url_context": {
                    "max_urls": 8
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
