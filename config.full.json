{
  "tracing": {
    "filter": "info",
    "database_level": "error"
  },
  "telemetry": {
    "enabled": false,
    "service_name": "agena"
  },
  "default": {
    "provider": "openai",
    "adapter": "openai",
    "model": "gpt-5.5",
    "agent": "build"
  },
  "runtime": {
    "provider_http": {
      "timeout_secs": 120,
      "connect_timeout_secs": 15
    },
    "request_retry": {
      "max_retries": 5,
      "base_delay_ms": 250,
      "max_delay_ms": 2000
    },
    "stream_replay": {
      "max_retries_after_output": 5,
      "max_tracked_events": 2048
    },
    "reload": {
      "enabled": true,
      "poll_interval_secs": 2
    },
    "janitor": {
      "enabled": true,
      "interval_secs": 30
    },
    "session_cache": {
      "max_sessions": 128,
      "ttl_secs": 900,
      "max_bytes": 67108864
    },
    "model_catalog": {
      "cache_max_age_secs": 604800
    }
  },
  "agents": {
    "plan": {
      "description": "Read-only planning agent",
      "prompt": "You are a planning agent. Break work into concrete steps, surface assumptions and blockers, and keep the output actionable.",
      "allowed_entries": [
        "read",
        "view_file",
        "glob",
        "grep",
        "bash",
        "todo_write",
        "enter_plan_mode",
        "exit_plan_mode"
      ],
      "mode": "all",
      "permission": {
        "path": {
          "workspace": {
            "read": "allow",
            "write": "deny"
          },
          "external": {
            "read": "ask",
            "write": "ask"
          }
        },
        "entries": {
          "names": {
            "enter_plan_mode": "allow",
            "exit_plan_mode": "allow",
            "todo_write": "allow"
          }
        }
      }
    }
  },
  "permission": {
    "path": {
      "workspace": {
        "read": "allow",
        "write": "ask"
      },
      "external": {
        "read": "ask",
        "write": "ask"
      },
      "rules": {
        "<cwd>/.env*": {
          "read": "ask",
          "write": "deny"
        },
        "<cwd>/secrets/**": {
          "read": "deny",
          "write": "deny"
        }
      }
    },
    "network": {
      "internet": "ask",
      "private": "deny",
      "loopback": "deny",
      "rules": {
        "github.com:443": "allow",
        "api.github.com": "allow",
        "*.corp.local": "ask",
        "*.corp.local:8443": "allow",
        "10.0.0.0/8": "deny",
        "172.16.0.0/12:*": "ask",
        "fd00::/8": "deny",
        "[::1]:3000": "ask"
      }
    },
    "entries": {
      "tags": {
        "filesystem_read": "allow",
        "filesystem_write": "ask",
        "network": "ask",
        "internet": "ask",
        "task": "ask",
        "shell": "ask"
      },
      "names": {
        "bash": "ask",
        "apply_patch": "ask"
      }
    }
  },
  "plugins": {
    "enabled": true,
    "list": {
      "agena.memory": {
        "kind": "static",
        "options": {
          "project_instructions": {
            "enabled": true,
            "include_global": true
          }
        }
      }
    }
  },
  "providers": {
    "openai": {
      "default_adapter": "openai",
      "default_model": "gpt-5.5",
      "auth": {
        "mode": "api",
        "base_url": "https://api.openai.com",
        "api_key_env": "OPENAI_API_KEY"
      },
      "adapters": {
        "openai": {
          "enabled": true,
          "api_mode": "auto",
          "stream_mode": "sse"
        }
      }
    },
    "openai_chatgpt": {
      "default_adapter": "openai",
      "default_model": "gpt-5.3-codex",
      "auth": {
        "mode": "credential",
        "issuer": "openai_chatgpt",
        "credential": {
          "type": "oauth",
          "issuer": "openai_chatgpt",
          "refresh": "openai-refresh-token",
          "access": "openai-access-token",
          "expires_at_ms": 4102444800000,
          "account_id": "acct-example"
        }
      },
      "adapters": {
        "openai": {
          "enabled": true,
          "backend": "chatgpt_codex"
        }
      }
    },
    "atomgit": {
      "default_adapter": "openai",
      "default_model": "Kimi-K2-Instruct",
      "auth": {
        "mode": "credential",
        "issuer": "atomgit",
        "credential": {
          "type": "oauth",
          "issuer": "atomgit",
          "refresh": "atomgit-refresh-token",
          "access": "atomgit-access-token",
          "expires_at_ms": 4102444800000,
          "account_id": "atomgit-user"
        }
      },
      "adapters": {
        "openai": {
          "enabled": true,
          "models": {
            "Kimi-K2-Instruct": {
              "enabled": true
            }
          }
        }
      }
    },
    "github-copilot": {
      "default_adapter": "openai",
      "default_model": "gpt-4o-mini",
      "auth": {
        "mode": "credential",
        "issuer": "github_copilot",
        "credential": {
          "type": "oauth",
          "issuer": "github_copilot",
          "refresh": "copilot-refresh-token",
          "access": "copilot-access-token",
          "expires_at_ms": 4102444800000
        }
      },
      "adapters": {
        "openai": {
          "enabled": true,
          "models": {
            "gpt-4o-mini": {}
          }
        },
        "anthropic": {
          "enabled": true,
          "models": {
            "claude-sonnet-4": {}
          }
        }
      }
    },
    "ollama": {
      "default_adapter": "ollama",
      "default_model": "qwen3:14b",
      "adapters": {
        "ollama": {
          "enabled": true,
          "base_url": "http://localhost:11434"
        }
      }
    },
    "gitlab": {
      "default_adapter": "gitlab",
      "default_model": "claude-sonnet-4-5",
      "auth": {
        "mode": "credential",
        "issuer": "gitlab",
        "credential": {
          "type": "oauth",
          "issuer": "gitlab",
          "refresh": "gitlab-refresh-token",
          "access": "gitlab-access-token",
          "expires_at_ms": 4102444800000
        }
      },
      "adapters": {
        "gitlab": {
          "enabled": true,
          "instance_url": "https://gitlab.com",
          "ai_gateway_url": "https://cloud.gitlab.com"
        }
      }
    },
    "shared-gateway": {
      "default_adapter": "openai",
      "default_model": "gpt-4.1-mini",
      "auth": {
        "mode": "api",
        "base_url": "https://api.cxits.cn/",
        "api_key_env": "CX_API_KEY",
        "protocol_paths": {
          "openai": "/v1",
          "anthropic": "/v1",
          "gemini": "/v1beta"
        }
      },
      "adapters": {
        "openai": {
          "enabled": true,
          "models": {
            "gpt-4.1-mini": {}
          }
        },
        "anthropic": {
          "enabled": true,
          "models": {
            "claude-sonnet-4": {}
          }
        },
        "gemini": {
          "enabled": true,
          "models": {
            "gemini-2.5-pro": {}
          }
        }
      }
    },
    "google-vertex": {
      "default_adapter": "openai",
      "default_model": "google/gemini-2.5-flash",
      "auth": {
        "mode": "api",
        "base_url": "https://us-central1-aiplatform.googleapis.com",
        "api_key_env": "GOOGLE_VERTEX_ACCESS_TOKEN",
        "protocol_paths": {
          "openai": "/v1/projects/PROJECT/locations/us-central1/endpoints/openapi"
        }
      },
      "adapters": {
        "openai": {
          "enabled": true,
          "capability_family": "gemini"
        }
      }
    }
  }
}
