{
  "tracing": {
    "filter": "info",
    "database": "error"
  },
  "ui": {
    "locale": null,
    "tui": {
      "color_scheme": "auto",
      "graphics": "auto",
      "theme": null,
      "transcript": {
        "activity_default_expanded": false,
        "activity_kinds": {
          "reasoning": true
        }
      }
    }
  },
  "runtime": {
    "providers": {
      "client_versions": {
        "codex": "0.144.4",
        "claude": "2.1.209",
        "gemini": "0.50.0"
      }
    }
  },
  "session": {
    "compaction": {
      "auto": true,
      "reserved_tokens": 12000
    },
    "max_turns": 500
  },
  "permission": {
    "path": {
      "workspace": {
        "read": "allow",
        "write": "auto"
      },
      "external": {
        "read": "auto",
        "write": "auto"
      },
      "rules": {
        "<cwd>/.env*": {
          "read": "auto",
          "write": "deny"
        },
        "<cwd>/secrets/**": {
          "read": "deny",
          "write": "deny"
        }
      }
    },
    "network": {
      "internet": "auto",
      "private": "auto",
      "loopback": "auto",
      "rules": {
        "github.com:443": "allow",
        "api.github.com": "allow",
        "*.corp.local": "auto",
        "*.corp.local:8443": "allow",
        "10.0.0.0/8": "deny",
        "172.16.0.0/12:*": "auto",
        "fd00::/8": "deny",
        "[::1]:3000": "auto"
      }
    },
    "tools": {
      "names": {
        "agena.shell.run": "auto",
        "agena.fs.apply_patch": "auto"
      }
    }
  },
  "plugins": {
    "list": {
      "agena.skills": {
        "package": {
          "kind": "static"
        }
      },
      "agena.lsp": {
        "package": {
          "kind": "static"
        },
        "settings": {
          "servers": {}
        }
      },
      "agena.cron": {
        "package": {
          "kind": "static"
        }
      },
      "agena.code": {
        "package": {
          "kind": "static"
        }
      },
      "agena.fs": {
        "package": {
          "kind": "static"
        }
      },
      "agena.settings": {
        "package": {
          "kind": "static"
        }
      },
      "agena.shell": {
        "package": {
          "kind": "static"
        }
      },
      "agena.plan": {
        "package": {
          "kind": "static"
        },
        "settings": {
          "default_autorun": true
        }
      },
      "agena.memory": {
        "package": {
          "kind": "static"
        },
        "settings": {
          "project_instructions": {
            "enabled": true,
            "include_global": true
          },
          "retrieval": {
            "enabled": true,
            "limit": 3,
            "min_query_chars": 8
          }
        }
      },
      "agena.web": {
        "package": {
          "kind": "static"
        },
        "settings": {
          "fetch": {
            "enabled": true,
            "request": {
              "delay_ms": 400,
              "timeout_secs": 30,
              "max_body_bytes": 5242880,
              "respect_robots_txt": true
            },
            "cache": {
              "ttl_secs": 900,
              "capacity": 128
            }
          },
          "crawl": {
            "defaults": {
              "max_pages": 10,
              "max_depth": 1,
              "same_host_only": true
            },
            "limits": {
              "max_pages": 100,
              "max_depth": 4
            },
            "indexing": {
              "document_cache_ttl_secs": 86400,
              "chunk_chars": 1800,
              "near_duplicate_hamming_distance": 3
            }
          },
          "search": {
            "default_limit": 5,
            "max_limit": 20
          },
          "store": {
            "retention": {
              "max_documents": 200,
              "max_bytes": 104857600
            }
          },
          "browser": {
            "enabled": false,
            "executable_path": null,
            "idle_timeout_secs": 300,
            "wait": {
              "for_network_idle": true,
              "timeout_secs": 10,
              "for_selector": null,
              "delay_ms": 0
            }
          }
        }
      },
      "agena.mcp": {
        "package": {
          "kind": "static"
        },
        "settings": {
          "servers": {
            "docs": {
              "transport": "http",
              "endpoint": {
                "url": "https://developers.openai.com/mcp",
                "headers": {}
              },
              "auth": {
                "kind": "bearer_from_env",
                "env": "DOCS_MCP_TOKEN"
              }
            }
          }
        }
      }
    }
  },
  "harnesses": {
    "browser": {
      "default": {
        "driver": "playwright",
        "headless": true,
        "viewport": {
          "width": 1280,
          "height": 800
        },
        "allowed_domains": [
          "example.com",
          "github.com"
        ]
      }
    },
    "shell": {
      "default": {
        "workspace_only": true,
        "deny_commands": [
          "sudo",
          "rm -rf /"
        ]
      }
    },
    "editor": {
      "default": {
        "workspace_only": true,
        "max_file_bytes": 262144
      }
    }
  },
  "providers": {
    "openai": {
      "auth": {
        "mode": "api",
        "subtype": "custom",
        "base_url": "https://api.openai.com",
        "api_key": {
          "kind": "env",
          "value": "OPENAI_API_KEY"
        }
      },
      "network": {
        "request_timeout_secs": 120,
        "connect_timeout_secs": 15
      },
      "adapters": {
        "openai_responses": {
          "enabled": true,
          "models": {
            "gpt-5.5": {
              "agena_tools": {
                "mode": "provider_protocol"
              }
            }
          }
        },
        "openai_chat_completions": {
          "enabled": false,
          "models": {
            "gpt-4.1-mini": {}
          }
        },
        "openai_realtime": {
          "enabled": false,
          "realtime_ws_url": "wss://api.openai.com/v1/realtime",
          "models": {
            "gpt-realtime": {}
          }
        }
      }
    },
    "anthropic": {
      "auth": {
        "mode": "api",
        "subtype": "custom",
        "base_url": "https://api.anthropic.com",
        "api_key": {
          "kind": "env",
          "value": "ANTHROPIC_API_KEY"
        }
      },
      "adapters": {
        "anthropic": {
          "enabled": true,
          "models": {
            "claude-sonnet-4-6": {
              "agena_tools": {
                "mode": "provider_protocol"
              }
            }
          }
        }
      }
    },
    "openai_chatgpt": {
      "auth": {
        "mode": "credential",
        "issuer": "openai_chatgpt",
        "credential": {
          "type": "oauth",
          "issuer": "openai_chatgpt",
          "refresh": "openai-refresh-token",
          "access": "openai-access-token",
          "expires_at_ms": 4102444800000,
          "account_id": "acct-example"
        }
      },
      "adapters": {
        "openai_responses": {
          "enabled": true,
          "backend": "chatgpt_codex"
        }
      }
    },
    "github-copilot": {
      "auth": {
        "mode": "credential",
        "issuer": "github_copilot",
        "credential": {
          "type": "oauth",
          "issuer": "github_copilot",
          "refresh": "copilot-refresh-token",
          "access": "copilot-access-token",
          "expires_at_ms": 4102444800000
        }
      },
      "adapters": {
        "openai_chat_completions": {
          "enabled": true,
          "models": {
            "gpt-4o-mini": {}
          }
        },
        "anthropic": {
          "enabled": true,
          "models": {
            "claude-sonnet-4": {}
          }
        }
      }
    },
    "ollama": {
      "adapters": {
        "ollama": {
          "enabled": true,
          "base_url": "http://localhost:11434"
        }
      }
    },
    "gitlab": {
      "auth": {
        "mode": "credential",
        "issuer": "gitlab",
        "credential": {
          "type": "oauth",
          "issuer": "gitlab",
          "refresh": "gitlab-refresh-token",
          "access": "gitlab-access-token",
          "expires_at_ms": 4102444800000
        }
      },
      "adapters": {
        "gitlab": {
          "enabled": true,
          "instance_url": "https://gitlab.com",
          "ai_gateway_url": "https://cloud.gitlab.com"
        }
      }
    },
    "shared-gateway": {
      "auth": {
        "mode": "api",
        "subtype": "custom",
        "base_url": "https://api.cxits.cn/",
        "api_key": {
          "kind": "env",
          "value": "CX_API_KEY"
        },
        "protocol_paths": {
          "openai": "/v1",
          "anthropic": "/v1",
          "gemini": "/v1beta"
        }
      },
      "adapters": {
        "openai_chat_completions": {
          "enabled": true,
          "models": {
            "gpt-4.1-mini": {}
          }
        },
        "anthropic": {
          "enabled": true,
          "models": {
            "claude-sonnet-4": {}
          }
        },
        "gemini": {
          "enabled": true,
          "models": {
            "gemini-2.5-pro": {}
          }
        }
      }
    },
    "cline_api": {
      "auth": {
        "mode": "api",
        "subtype": "cline_api",
        "api_key": {
          "kind": "env",
          "value": "CLINE_API_KEY"
        }
      },
      "adapters": {
        "openai_chat_completions": {
          "enabled": true,
          "models_url": "https://api.cline.bot/api/v1/ai/cline/recommended-models",
          "models": {
            "cline-pass/qwen3.7-max": {}
          }
        }
      }
    },
    "google-vertex": {
      "auth": {
        "mode": "api",
        "subtype": "custom",
        "base_url": "https://us-central1-aiplatform.googleapis.com",
        "api_key": {
          "kind": "env",
          "value": "GOOGLE_VERTEX_ACCESS_TOKEN"
        },
        "protocol_paths": {
          "openai": "/v1/projects/PROJECT/locations/us-central1/endpoints/openapi"
        }
      },
      "adapters": {
        "openai_chat_completions": {
          "enabled": true,
          "capability_family": "gemini"
        }
      }
    },
    "google-ai": {
      "auth": {
        "mode": "api",
        "subtype": "custom",
        "base_url": "https://generativelanguage.googleapis.com",
        "api_key": {
          "kind": "env",
          "value": "GOOGLE_API_KEY"
        }
      },
      "adapters": {
        "gemini": {
          "enabled": true,
          "models": {
            "gemini-2.5-pro": {
              "agena_tools": {
                "mode": "provider_protocol"
              }
            }
          }
        }
      }
    }
  }
}
