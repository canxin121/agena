    "network": {
      "allow": [
        {
          "to": "::ffff:192.0.2.10",
          "protocol": "tcp",
          "ports": [443]
        }
      ]
    },
    "checks": [
      {
        "ip": "192.0.2.10",
        "protocol": "tcp",
        "port": 443,
        "allowed": true
      },
      {
        "ip": "::ffff:192.0.2.10",
        "protocol": "tcp",
        "port": 443,
        "allowed": true
      },
      {
        "ip": "192.0.2.11",
        "protocol": "tcp",
        "port": 443,
        "allowed": false
      }
    ]
  },
  {
    "name": "default allow ignores redundant narrow grants",
    "selective": false,
    "network": {
      "default": "allow",
      "allow": [
        {
          "to": "192.0.2.0/24",
          "protocol": "tcp",
          "ports": [443]
        }
      ]
    },
    "checks": [
      {
        "ip": "198.51.100.10",
        "protocol": "tcp",
        "port": 80,
        "allowed": true
      },
      {
        "ip": "2001:db8::10",
        "protocol": "icmp",
        "port": null,
        "allowed": true
      },
      {
        "ip": "127.0.0.1",
        "protocol": "tcp",
        "port": 443,
        "allowed": false
      }
    ]
  },
  {
    "name": "default deny without grants ignores redundant denies",
    "selective": false,
    "network": {
      "default": "deny",
      "deny": [
        {
          "to": "192.0.2.0/24",
          "protocol": "udp",
          "ports": [53]
        }
      ]
    },
    "checks": [
      {
        "ip": "192.0.2.10",
        "protocol": "udp",
        "port": 53,
        "allowed": false
      },
      {
        "ip": "198.51.100.10",
        "protocol": "tcp",
        "port": 443,
        "allowed": false
      },
      {
        "ip": "2001:db8::10",
        "protocol": "icmp",
        "port": null,
        "allowed": false
      }
    ]
  },
  {
    "name": "unconditional wildcard grant lowers to outbound allow",
    "selective": false,
    "network": {
      "default": "deny",
      "allow": [
        {
          "to": "*"
        }
      ]
    },
    "checks": [
      {
        "ip": "192.0.2.10",
        "protocol": "tcp",
        "port": 443,
        "allowed": true
      },
      {
        "ip": "2001:db8::10",
        "protocol": "any",
        "port": null,
        "allowed": true
      },
      {
        "ip": "::1",
        "protocol": "udp",
        "port": 53,
        "allowed": false
      }
    ]
  },
  {
    "name": "unconditional wildcard deny overrides allow default and grants",
    "selective": false,
    "network": {
      "default": "allow",
      "allow": [
        {
          "to": "192.0.2.10",
          "ports": [443]
        }
      ],
      "deny": [
        {
          "to": "*"
        }
      ]
    },
    "checks": [
      {
        "ip": "192.0.2.10",
        "protocol": "tcp",
        "port": 443,
        "allowed": false
      },
      {
        "ip": "2001:db8::10",
        "protocol": "icmp",
        "port": null,
        "allowed": false
      },
      {
        "ip": "198.51.100.10",
        "protocol": "udp",
        "port": 53,
        "allowed": false
      }
    ]
  },
  {
    "name": "unconditional deny wins when both lists grant every endpoint",
    "selective": false,
    "network": {
      "allow": [
        {
          "to": "*"
        }
      ],
      "deny": [
        {
          "to": "*"
        }
      ]
    },
    "checks": [
      {
        "ip": "192.0.2.10",
        "protocol": "tcp",
        "port": 443,
        "allowed": false
      },
      {
        "ip": "2001:db8::10",
        "protocol": "udp",
        "port": 53,
        "allowed": false
      }
    ]
  },
  {
    "name": "wildcard grant retains concrete deny and its exclusions",
    "selective": true,
    "network": {
      "allow": [
        {
          "to": "*"
        }
      ],
      "deny": [
        {
          "to": "192.0.2.0/24",
          "except": ["192.0.2.64/26"],
          "protocol": "tcp",
          "ports": [443]
        }
      ]
    },
    "checks": [
      {
        "ip": "192.0.2.10",
        "protocol": "tcp",
        "port": 443,
        "allowed": false
      },
      {
        "ip": "192.0.2.80",
        "protocol": "tcp",
        "port": 443,
        "allowed": true
      },
      {
        "ip": "192.0.2.10",
        "protocol": "udp",
        "port": 443,
        "allowed": true
      },
      {
        "ip": "2001:db8::10",
        "protocol": "tcp",
        "port": 443,
        "allowed": true
      }
    ]
  }
]
