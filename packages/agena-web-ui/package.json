{
  "name": "agena-web-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run vite",
    "typecheck": "bun ./node_modules/vue-tsc/bin/vue-tsc.js -b",
    "vue-tsc": "bun ./node_modules/vue-tsc/bin/vue-tsc.js",
    "build": "bun run check:imports && bun run typecheck && bun run vite build",
    "build:rust-debug": "bun run check:imports && bun run typecheck && bun run vite build --mode rust-debug",
    "check:imports": "bun ./scripts/check-import-rules.mjs",
    "fmt": "bun ./node_modules/prettier/bin/prettier.cjs -w .",
    "fmt:check": "bun ./node_modules/prettier/bin/prettier.cjs -c .",
    "preview": "bun run vite preview",
    "vite": "bun ./node_modules/vite/bin/vite.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@remixicon/vue": "^4.9.0",
    "@vueuse/core": "^14.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.3.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "postcss": "^8.5.18",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "esbuild": "^0.28.1",
    "vite": "^8.1.4",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "defu": "6.1.7",
    "dompurify": "3.4.12",
    "lodash-es": "4.18.1",
    "picomatch": "4.0.5",
    "postcss": "^8.5.18",
    "uuid": "14.0.1"
  }
}
