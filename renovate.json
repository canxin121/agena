{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "groupName": "rust dependencies"
    },
    {
      "matchManagers": ["bun"],
      "matchFileNames": ["packages/agena-studio-web/package.json"],
      "groupName": "web dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["packages/agena-vscode/package.json"],
      "groupName": "VS Code dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["bun-version"],
      "groupName": "Bun runtime"
    },
    {
      "matchManagers": ["nodenv"],
      "groupName": "Node.js runtime"
    }
  ]
}
